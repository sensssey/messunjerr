<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block title %}{{ app_name }}{% endblock %}</title>
</head>
<body style="margin:0;padding:24px;background:#f4f5f7;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#1f2933;">
  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="border-collapse:collapse;">
    <tr>
      <td align="center">
        <table role="presentation" width="560" cellspacing="0" cellpadding="0" style="max-width:560px;width:100%;background:#ffffff;border-radius:12px;">
          <tr>
            <td style="padding:32px;font-size:16px;line-height:1.5;">
              <h1 style="margin:0 0 16px;font-size:20px;line-height:1.3;">{% block heading %}{% endblock %}</h1>
              {% block content %}{% endblock %}
              <p style="margin:32px 0 0;color:#6b7280;font-size:12px;">
                Это автоматическое письмо от {{ app_name }}. Отвечать на него не нужно.
              </p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
