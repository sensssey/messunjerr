[importlinter]
root_package = messunjerr
include_external_packages = False

# Граф зависимостей контекстов из backend-v2-spec 4.2: стрелка значит «может импортировать».
# Слои идут сверху вниз; верхний слой видит нижние, соседи через « | » друг друга не видят.
# Правила «чужой контекст только через api_public» добавляются вместе с первым кодом контекста.
[importlinter:contract:layers]
name = Контексты зависят только вниз по графу 4.2
type = layers
layers =
    messunjerr.realtime | messunjerr.moderation
    messunjerr.chat | messunjerr.content | messunjerr.notifications
    messunjerr.media | messunjerr.social
    messunjerr.profiles
    messunjerr.identity
    messunjerr.core

# Раскладка внутри контекста (4.4): роутеры вызывают команды и запросы, те работают через
# репозитории и модели, а предметные правила (domain) ни от чего из этого не зависят.
# Команды и запросы не импортируют api/. Каждый следующий контекст добавляет такой же контракт.
[importlinter:contract:identity-layers]
name = Внутри identity: api, commands, queries, infra, domain
type = layers
containers =
    messunjerr.identity
layers =
    api
    commands
    queries
    infra
    domain

[importlinter:contract:profiles-layers]
name = Внутри profiles: api, commands, queries, infra, domain
type = layers
containers =
    messunjerr.profiles
layers =
    api
    commands
    queries
    infra
    domain

[importlinter:contract:media-layers]
name = Внутри media: api, commands, queries, infra, domain
type = layers
containers =
    messunjerr.media
layers =
    api
    commands
    queries
    infra
    domain

# Контексты выше identity берут у него только публичный интерфейс (4.2, правило 1): зависимости
# аутентификации, карточку аккаунта и порты. Модели, репозитории и команды identity им не видны.
# Косвенные импорты разрешены: сам `api_public` стоит поверх внутренностей identity.
[importlinter:contract:identity-public-interface]
name = Другие контексты видят identity только через api_public
type = forbidden
source_modules =
    messunjerr.profiles
    messunjerr.social
    messunjerr.content
    messunjerr.chat
    messunjerr.notifications
    messunjerr.media
    messunjerr.moderation
    messunjerr.realtime
forbidden_modules =
    messunjerr.identity.api
    messunjerr.identity.commands
    messunjerr.identity.queries
    messunjerr.identity.infra
    messunjerr.identity.domain
    messunjerr.identity.services
allow_indirect_imports = True

# Точки сборки (приложение, CLI, фоновые процессы) собирают контексты, но не наоборот.
[importlinter:contract:roots]
name = Ядро и контексты не импортируют точки сборки
type = forbidden
source_modules =
    messunjerr.core
    messunjerr.identity
    messunjerr.profiles
    messunjerr.social
    messunjerr.content
    messunjerr.chat
    messunjerr.notifications
    messunjerr.media
    messunjerr.moderation
    messunjerr.realtime
forbidden_modules =
    messunjerr.main
    messunjerr.cli
    messunjerr.seeding
    messunjerr.system
    messunjerr.spike
    messunjerr.jobs
    messunjerr.consumers
    messunjerr.relay
