# Переменные локального стека (deploy/compose.dev.yml). Файл deploy/.env создаётся командой
# `make init` или `./dev.ps1 init`: значения-заглушки в паролях заменяются случайными. В git он не попадает.
# После обновления проекта та же команда дописывает новые переменные, не трогая существующие.

POSTGRES_PASSWORD=CHANGE_ME
DB_NAME=messunjerr
DB_MIGRATOR_PASSWORD=CHANGE_ME
DB_APP_PASSWORD=CHANGE_ME
DB_READONLY_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME

# Ключи приложения в SeaweedFS (S3 API на http://localhost:8333, bucket media); в S5 их берёт API.
S3_APP_ACCESS_KEY=CHANGE_ME
S3_APP_SECRET_KEY=CHANGE_ME

# Ключ подписи access-токенов: seed Ed25519 (32 байта, base64url). Постоянный, чтобы токены
# переживали перезапуск API. В проде вместо него JWT_PRIVATE_KEY_FILE с PEM-файлом.
JWT_PRIVATE_KEY=CHANGE_ME_JWT_SEED

# Адрес клиента: в письмах ссылки ведут на него. Пока клиента нет, токен можно взять из письма в Mailpit.
PUBLIC_BASE_URL=http://localhost:3000

# Порты на 127.0.0.1. Подобраны так, чтобы не пересекаться со стеком v0.1 (1221, 3245, 1337)
# и с обычными PostgreSQL (5432, 5433) и Redis (6379) на машине.
API_PORT=8000
PG_PORT=54320
REDIS_PORT=63790
S3_PORT=8333
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
