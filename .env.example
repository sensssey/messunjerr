# =============================================================================
#  messunjerr: пример переменных окружения для Docker Compose
#
#  Скопируйте файл в .env и задайте свои значения:
#      cp .env.example .env              (PowerShell: Copy-Item .env.example .env)
#
#  Файл .env в git не попадает (см. .gitignore). Не коммитьте реальные секреты.
#  Этот же .env читают и docker-compose (подстановка в сервис db), и контейнер backend.
# =============================================================================

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_USER=messunjerr
POSTGRES_PASSWORD=change-me
POSTGRES_DB=messunjerr

# --- Как бэкенд подключается к БД ---------------------------------------------
# В Docker Compose БД доступна по имени сервиса: db:5432.
# Для запуска бэкенда без Docker (см. README) укажите localhost и порт 3245.
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- JWT ----------------------------------------------------------------------
# Ключ подписи токенов. Сгенерировать:
#     python -c "import secrets; print(secrets.token_hex(32))"
# Без него бэкенд не запустится.
SECRET_KEY=change-me-generate-a-long-random-string
ALGORITHM=HS256
# Срок жизни токена в минутах (1440 = 24 часа)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Необязательные настройки бэкенда -----------------------------------------
# Адреса фронтенда, которым разрешены запросы из браузера (через запятую).
# По умолчанию: localhost и 127.0.0.1 на портах 1337 (Docker) и 3000 (npm start).
# CORS_ORIGINS=http://localhost:1337,http://localhost:3000

# Максимальный размер загружаемого аватара в байтах (по умолчанию 5 МБ)
# AVATAR_MAX_BYTES=5242880

# Писать в лог все SQL-запросы (только для отладки)
# SQL_ECHO=true
