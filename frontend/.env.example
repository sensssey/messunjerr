# Адрес API так, как его видит БРАУЗЕР (запросы идут из браузера, а не из контейнера).
# Для docker-compose.yml это порт, проброшенный у сервиса backend (1221 -> 8000).
# Не используйте здесь http://backend:8000: это имя существует только внутри сети Docker.
#
# Скопируйте в frontend/.env:   cp frontend/.env.example frontend/.env
# Значение читается при старте dev-сервера: после правки перезапустите контейнер frontend.
REACT_APP_API_URL=http://localhost:1221
